{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ponevez-kibbudim",
  "main": "worker.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": {
    "SITE_URL": "https://ponevez.com/high-holidays",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAEeIveq_OFu0vLlh"
  },
  "routes": [
    {
      "pattern": "ponevez.com/high-holidays*",
      "zone_name": "ponevez.com"
    },
    {
      "pattern": "www.ponevez.com/high-holidays*",
      "zone_name": "ponevez.com"
    },
    {
      "pattern": "ponevez.com/kibbudim*",
      "zone_name": "ponevez.com"
    },
    {
      "pattern": "www.ponevez.com/kibbudim*",
      "zone_name": "ponevez.com"
    },
    {
      "pattern": "ponevez.com/robots.txt",
      "zone_name": "ponevez.com"
    },
    {
      "pattern": "www.ponevez.com/robots.txt",
      "zone_name": "ponevez.com"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ponevez-kibbudim",
      "database_id": "9f89db21-4717-451a-9668-a07dadb9f5d3",
      "migrations_dir": "migrations"
    }
  ]
}
