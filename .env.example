# Buyer payments use the Ponevez Admire donation form. If Admire gives the
# kibbud campaign a numeric ID, set it here so donations are categorized there.
ADMIRE_CAMPAIGN_ID=

# Legacy Banquest charging is disabled by default. Keep it false in production;
# the remaining variables are only for historical reconciliation and sandbox tests.
ENABLE_LEGACY_BANQUEST_CHECKOUT=false
BANQUEST_ENV=sandbox
BANQUEST_SOURCE_KEY=replace_me
BANQUEST_PIN=replace_me
BANQUEST_TOKENIZATION_KEY=pk_replace_me
BANQUEST_WEBHOOK_SIGNATURE=replace_after_webhook_registration

# Banquest test-card amounts below $100 approve. This override is ignored in production.
BANQUEST_SANDBOX_AMOUNT_USD=1

# Optional real-sandbox test values. Generate a fresh nonce in the hosted iframe;
# it expires after 15 minutes.
# BANQUEST_TEST_NONCE=replace_with_fresh_nonce
# BANQUEST_TEST_EXPIRY_MONTH=12
# BANQUEST_TEST_EXPIRY_YEAR=2030
# BANQUEST_TEST_AVS_ZIP=10001

# Cloudflare D1 is configured through the DB binding in wrangler.jsonc.
# It does not use a URL, password, or application-visible database credential.
SITE_URL=http://localhost:3110/high-holidays
OFFICE_NOTIFY_EMAIL=office@example.org
# Password for the browser's /admin login and token for admin API scripts.
ADMIN_TOKEN=replace_with_a_long_random_value
# Separate signing secret so changing the office password is not the only way to invalidate sessions.
ADMIN_SESSION_SECRET=replace_with_another_long_random_value

# Both campaign waves are open. These optional overrides can schedule a future opening.
WAVE_1_OPENS_AT=2026-08-25T00:00:00-04:00
WAVE_2_OPENS_AT=2026-08-25T00:00:00-04:00

# Optional bot protection. Configure both values together.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace_me
TURNSTILE_SECRET_KEY=replace_me

# Optional privacy-first Cloudflare Web Analytics beacon token.
NEXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=replace_me

# Optional email transport. Without it, messages remain in the D1 outbox.
RESEND_API_KEY=re_replace_me
# Use a sender on a domain that has been verified by the email provider.
EMAIL_FROM=American Friends of Ponevez Yeshiva <receipts@example.org>
# Included only in legacy office-arranged payment emails. Do not include private
# banking information unless the office has approved sending it by email.
OFFICE_PAYMENT_INSTRUCTIONS=Contact office@ponevez.com or 212-675-9260 to arrange payment.
